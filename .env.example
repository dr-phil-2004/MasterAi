# --- Plateforme MasterAI ---------------------------------------------------
# Base de données de la plateforme (projets, exécutions, agents, secrets chiffrés).
DATABASE_URL=postgresql://user:pass@host/masterai

# Stockage Mastra (mémoire, snapshots de workflow, traces). Par défaut = DATABASE_URL, sinon LibSQL local.
# MASTRA_DATABASE_URL=postgresql://user:pass@host/mastra
# MASTRA_LIBSQL_URL=file:./.mastra/masterai.db

# Clé maître de chiffrement des secrets (AES-256-GCM) : 32 octets en base64.
# Générer avec : openssl rand -base64 32
MASTERAI_ENCRYPTION_KEY=

# Propriétaire par défaut (mode mono-utilisateur).
MASTERAI_OWNER_EMAIL=owner@example.com

LOG_LEVEL=info

# --- Mastra Studio (optionnel, `pnpm dev:studio`) --------------------------
# Studio utilise les variables d'environnement des fournisseurs, pas les clés des utilisateurs.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Les clés des fournisseurs de modèles et les jetons d'intégration (GitHub, Vercel,
# Neon, Figma, Slack, e-mail) NE se mettent PAS ici : chaque utilisateur les saisit
# dans l'UI (Paramètres → Modèles / Intégrations), où ils sont chiffrés en base.
