{
  "name": "masterai",
  "private": true,
  "description": "Plateforme d'orchestration d'agents IA pour automatiser toute la chaîne de développement (Mastra).",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:studio": "pnpm --filter @masterai/core mastra:dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @masterai/db generate",
    "db:migrate": "pnpm --filter @masterai/db migrate",
    "db:seed": "pnpm --filter @masterai/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
